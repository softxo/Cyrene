<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CyreneAchievementScanner</AssemblyName>
    <RootNamespace>CyreneAchievementScanner</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon Condition="Exists('vendor\app.ico')">vendor\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup Condition="Exists('vendor\YaeAchievement.exe')">
    <EmbeddedResource Include="vendor\YaeAchievement.exe"
                      LogicalName="CyreneAchievementScanner.YaeAchievement.exe" />
  </ItemGroup>
</Project>
