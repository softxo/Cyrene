<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CyreneScanner</AssemblyName>
    <RootNamespace>CyreneAchievementScanner</RootNamespace>
    <Version>1.1.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>assets\Cyrene-dark.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup Condition="Exists('vendor\YaeAchievement.exe')">
    <EmbeddedResource Include="vendor\YaeAchievement.exe"
                      LogicalName="CyreneAchievementScanner.YaeAchievement.exe" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\Cyrene-dark.ico" />
  </ItemGroup>
</Project>
