<Window x:Class="CyreneAchievementScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyrene Scanner" Width="980" Height="680"
        Icon="assets/Cyrene-dark.ico"
        MinWidth="840" MinHeight="610" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.82,0.08" GradientOrigin="0.82,0.08" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#39202D" Offset="0" />
                <GradientStop Color="#160F15" Offset="0.38" />
                <GradientStop Color="#0F0D12" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="42,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Width="54" Height="54" CornerRadius="15" Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="#654055" BorderThickness="1">
                <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Fill="{StaticResource AccentBrush}"
                          Data="M12,0 L15,8.5 L24,12 L15,15.5 L12,24 L9,15.5 L0,12 L9,8.5 Z" />
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="CYRENE · SCANNER" Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="Bold" />
                <TextBlock Text="Import from Genshin" FontSize="31" FontWeight="Bold" Margin="0,4,0,4" />
                <TextBlock Text="Choose what you want to bring into Cyrene."
                           Foreground="{StaticResource MutedBrush}" FontSize="14" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="18" Padding="30">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.32" />
            </Border.Effect>
            <Grid>
                <StackPanel x:Name="HubPanel" VerticalAlignment="Center">
                    <TextBlock Text="What would you like to scan?" FontSize="23" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#513444"
                                BorderThickness="1" CornerRadius="14" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Achievements" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Scan completed achievements with Yae and create a UIAF file for Cyrene."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                                <Button Content="Achievement Scanner" Background="{StaticResource AccentBrush}"
                                        Foreground="#201018" Click="ChooseAchievements_Click" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource AccentSoftBrush}" BorderBrush="#513444"
                                BorderThickness="1" CornerRadius="14" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Wishes" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Find your Genshin wish-history URL with the official StarDB exporter."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18" />
                                <Button Content="Wish Scanner" Background="{StaticResource AccentBrush}"
                                        Foreground="#201018" Click="ChooseWishes_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <Button Style="{StaticResource BackNavigationButton}" HorizontalAlignment="Left" Margin="0,0,0,14"
                            ToolTip="Return to scanner selection" Click="BackToHub_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8,3 L2,9 L8,15 M2,9 H16" Stroke="{StaticResource MutedBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                            <TextBlock Text="Back to scanners" Foreground="{StaticResource MutedBrush}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="1  Choose Genshin executable" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="Select the executable used by your Genshin installation (e.g. C:\Program Files\HoYoPlay\games\Genshin Impact game\GenshinImpact.exe)."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,13" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="116" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GamePathBox" ToolTip="Path to GenshinImpact.exe or YuanShen.exe" />
                        <Button Grid.Column="2" Content="Browse" Click="BrowseGame_Click" />
                        <Button Grid.Column="4" Content="Auto-detect" Click="AutoDetectGame_Click" />
                    </Grid>

                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#513444" BorderThickness="1"
                            CornerRadius="12" Padding="17" Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="2  Before you continue" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                       Text="Genshin must be closed. The scanner will launch it and use Yae's unchanged local injection method. No game credentials are requested or uploaded by this app." />
                            <Button Content="View Yae source and licence" HorizontalAlignment="Left" Height="40" MinWidth="218"
                                    Padding="16,0" Margin="0,14,0,0"
                                    Click="OpenYaeSource_Click" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="StartButton" Content="Start achievement scan" Height="50" Margin="0,25,0,0"
                            Background="{StaticResource AccentBrush}" Foreground="#201018" FontWeight="Bold"
                            Click="StartScan_Click" />
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>

                <StackPanel x:Name="WishPanel" Visibility="Collapsed">
                    <Button Style="{StaticResource BackNavigationButton}" HorizontalAlignment="Left" Margin="0,0,0,12"
                            ToolTip="Return to scanner selection" Click="BackToHub_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8,3 L2,9 L8,15 M2,9 H16" Stroke="{StaticResource MutedBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                            <TextBlock Text="Back to scanners" Foreground="{StaticResource MutedBrush}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Wish Scanner" FontSize="23" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Select your Genshin installation so Cyrene can locate its local wish-history cache."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,13" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="116" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WishGamePathBox" ToolTip="Path to GenshinImpact.exe or YuanShen.exe" />
                        <Button Grid.Column="2" Content="Browse" Click="BrowseWishGame_Click" />
                        <Button Grid.Column="4" Content="Auto-detect" Click="AutoDetectWishGame_Click" />
                    </Grid>
                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="#513444" BorderThickness="1"
                            CornerRadius="12" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Before you continue" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                       Text="Cyrene opens Genshin for you. Enter the game and open Wish History; Cyrene uses the StarDB exporter's local-cache approach to find and copy the URL without uploading credentials." />
                            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                       Text="To scan wishes for a different account afterwards, close Genshin completely and relaunch it for that account before scanning again." />
                            <Button Content="View original StarDB project" Height="42" MinWidth="224"
                                    Padding="16,0" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Click="OpenStarDbSource_Click" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartWishButton" Content="Scan wish history" Height="48" Margin="0,16,0,0"
                            Background="{StaticResource AccentBrush}" Foreground="#201018" FontWeight="Bold"
                            Click="StartWish_Click" />
                    <TextBlock x:Name="WishStatusText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </StackPanel>

                <StackPanel x:Name="WishProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource ScannerProgressBar}" IsIndeterminate="True" />
                    <TextBlock Text="Waiting for Wish History" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,28,0,8" />
                    <TextBlock Text="Genshin has been opened. Enter the game, open the Wish screen, then open Wish History. Cyrene will detect it automatically."
                               Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="Cancel scan" Width="130" Margin="0,26,0,0" Click="CancelWish_Click" />
                </StackPanel>

                <StackPanel x:Name="WishSuccessPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Width="112" Height="112" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="4" CornerRadius="14">
                        <Viewbox Margin="25" Stretch="Uniform">
                            <Path Data="M4,13 L10,19 L22,5" Stroke="{StaticResource SuccessBrush}"
                                  StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Wish history found" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,22,0,7" />
                    <TextBlock x:Name="WishSuccessDescription"
                               Text="The wish-history URL has been copied to your clipboard. To scan a different account, close and relaunch Genshin before scanning again."
                               Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Content="Copy URL again" Width="150" Click="CopyWishUrl_Click" />
                        <Button Content="Open Cyrene" Width="150" Margin="12,0,0,0"
                                Background="{StaticResource AccentBrush}" Foreground="#201018"
                                Click="OpenCyreneWishes_Click" />
                    </StackPanel>
                    <Button Content="Scan another account" Width="180" Margin="0,12,0,0" Click="ResetWish_Click" />
                </StackPanel>

                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource ScannerProgressBar}" IsIndeterminate="True" />
                    <TextBlock x:Name="ProgressTitle" Text="Starting scanner…" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,28,0,8" />
                    <TextBlock x:Name="ProgressDescription" Text="Genshin will open automatically. Sign in and enter the game."
                               Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="Cancel" Width="120" Margin="0,26,0,0" Click="Cancel_Click" />
                </StackPanel>

                <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Width="112" Height="112" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="4" CornerRadius="14">
                        <Viewbox Margin="25" Stretch="Uniform">
                            <Path Data="M4,13 L10,19 L22,5"
                                  Stroke="{StaticResource SuccessBrush}"
                                  StrokeThickness="3.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Viewbox>
                    </Border>
                    <TextBlock Text="Scan complete" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,7" />
                    <TextBlock x:Name="SuccessDescription" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Content="Save export" Width="140" Click="SaveExport_Click" />
                        <Button Content="Open Cyrene" Width="140" Margin="12,0,0,0" Background="{StaticResource AccentBrush}"
                                Foreground="#201018" FontWeight="Bold" Click="OpenCyrene_Click" />
                    </StackPanel>
                    <Button Content="Scan again" Width="140" Margin="0,12,0,0" Click="Reset_Click" />
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
        <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,16,11" Foreground="{StaticResource MutedBrush}" FontSize="11"
                   Opacity="0.72" IsHitTestVisible="False" />
    </Grid>
</Window>
