{
    "name": "cyrene-frontend",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "vite build --config config/vite.config.ts && npm run build:scripts",
        "build:scripts": "tsc -p config/tsconfig.scripts.json",
        "lint": "eslint --config config/eslint.config.js website/src",
        "test:e2e": "playwright test --config config/playwright.config.ts",
        "prepare": "husky",
        "knip": "knip"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "knip": "^6.43.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.0",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4"
    },
    "dependencies": {
        "zod": "^4.6.7"
    },
    "prettier": {
        "printWidth": 100,
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "singleQuote": false,
        "trailingComma": "all"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "lint-staged": {
        "*.py": [
            ".venv/Scripts/python.exe -m ruff check --fix",
            ".venv/Scripts/python.exe -m ruff format"
        ],
        "*.{ts,tsx,js,mjs}": [
            "prettier --write"
        ],
        "website/src/**/*.{ts,tsx,js,mjs}": [
            "eslint --config config/eslint.config.js --fix"
        ],
        "*.{css,json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "knip": {
        "entry": [
            "website/src/browser/core/theme.ts",
            "website/src/browser/pages/**/*.ts",
            "tests/unit/**/*.test.mjs"
        ],
        "project": [
            "website/src/**/*.ts",
            "tests/**/*.{ts,js,mjs}",
            "!website/static/build/**"
        ],
        "eslint": {
            "config": [
                "config/eslint.config.js"
            ]
        },
        "vite": {
            "config": [
                "config/vite.config.ts"
            ],
            "entry": [
                "website/src/app.ts"
            ]
        },
        "playwright": {
            "config": [
                "config/playwright.config.ts"
            ]
        }
    }
}
