{
    "extends": ["config:recommended"],
    "baseBranchPatterns": ["maintenance"],
    "timezone": "Europe/London",
    "schedule": ["* 0-6 * * 1"],
    "dependencyDashboard": true,
    "prConcurrentLimit": 5,
    "automerge": false,
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "non-major dependencies"
        }
    ]
}
